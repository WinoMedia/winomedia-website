---
const title = "winomedia – Creative Digital Studio";
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="winomedia – Kreative Kommunikation, Branding und digitale Erlebnisse."
    />
    <title>{title}</title>
    <link rel="icon"
  type="image/png"
  href="/winomedia-website/05_social_icon_hell.png" />
  </head>

  <body>
    <header class="header">
      <a class="brand" href="#start" aria-label="winomedia Startseite">
        <img
  src="/winomedia-website/01_hauptlogo_original.png"
  alt="winomedia Logo"
/>
      <nav aria-label="Hauptnavigation">
        <a href="#leistungen">Leistungen</a>
        <a href="#studio">Studio</a>
        <a href="#kontakt">Kontakt</a>
      </nav>
    </header>

    <main id="start">
      <section class="hero">
        <div class="hero-content">
          <p class="eyebrow">INDEPENDENT CREATIVE STUDIO</p>
          <h1>Klar im Denken.<br />Stark im Design.</h1>
          <p class="hero-text">
            Wir verbinden kreative Ideen, durchdachte Gestaltung
            und digitale Kommunikation zu Markenauftritten
            mit Charakter.
          </p>
          <a class="button" href="#kontakt">
            Projekt anfragen <span>↗</span>
          </a>
        </div>
        <span class="hero-bottom">SCROLL TO EXPLORE ↓</span>
      </section>

      <section class="intro-section" id="leistungen">
        <div class="section-heading">
          <span class="eyebrow">01 / WAS WIR TUN</span>
          <h2>Weniger Ablenkung.<br />Mehr Wirkung.</h2>
        </div>

        <div class="service-list">
          <div class="service">
            <span>01</span>
            <h3>Strategie & Konzeption</h3>
            <span>↗</span>
          </div>
          <div class="service">
            <span>02</span>
            <h3>Branding & Design</h3>
            <span>↗</span>
          </div>
          <div class="service">
            <span>03</span>
            <h3>Web & Digital</h3>
            <span>↗</span>
          </div>
          <div class="service">
            <span>04</span>
            <h3>Content & Kommunikation</h3>
            <span>↗</span>
          </div>
        </div>
      </section>

      <section class="studio" id="studio">
        <div class="studio-text">
          <p class="eyebrow">02 / ÜBER WINOMEDIA</p>
          <h2>Gute Ideen verdienen gutes Design.</h2>
          <p>
            Wir glauben an klare Gestaltung, starke Konzepte
            und digitale Lösungen, die Menschen erreichen.
            Unkompliziert, kreativ und mit Liebe zum Detail.
          </p>
        </div>

        <div class="studio-art">
          <img
            src="/winomedia-website/05_social_icon_hell.png"
            alt="WM-Grafikelement von winomedia"
            loading="lazy"
          />
        </div>
      </section>

      <section class="contact" id="kontakt">
        <p class="eyebrow">03 / KONTAKT</p>
        <h2>Eine gute Idee<br />beginnt mit einem Gespräch.</h2>
        <a class="button" href="mailto:hello@winomedia.ch">
          Kontakt aufnehmen ↗
        </a>
      </section>
    </main>

    <footer>
      <span>© {new Date().getFullYear()} winomedia</span>
      <span>Creative Digital Studio</span>
      <a href="#start">Nach oben ↑</a>
    </footer>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    scroll-behavior: smooth;
  }

  :global(body) {
    margin: 0;
    background: #f7f5f0;
    color: #252521;
    font-family: Arial, Helvetica, sans-serif;
    -webkit-font-smoothing: antialiased;
  }

  :global(a) {
    color: inherit;
  }

  .header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 28px 7%;
  }

  .brand img {
    display: block;
    width: 180px;
    height: auto;
    max-height: 75px;
    object-fit: contain;
    object-position: left;
  }

  nav {
    display: flex;
    gap: 36px;
  }

  nav a {
    font-size: 13px;
    text-decoration: none;
  }

  nav a:hover {
    opacity: 0.55;
  }

  .hero {
    min-height: 85vh;
    padding: 100px 7% 45px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .hero-content {
    max-width: 1100px;
    padding: 50px 0 80px;
  }

  .eyebrow {
    font-size: 11px;
    letter-spacing: 2.5px;
    font-weight: 600;
    text-transform: uppercase;
  }

  h1, h2, h3 {
    font-weight: 400;
    letter-spacing: -0.055em;
  }

  h1 {
    font-size: clamp(50px, 8vw, 120px);
    line-height: 1.06;
    margin: 35px 0;
  }

  h2 {
    font-size: clamp(42px, 5.5vw, 82px);
    line-height: 1.1;
    margin: 30px 0;
  }

  .hero-text {
    max-width: 540px;
    color: #69665f;
    font-size: 19px;
    line-height: 1.7;
    margin-bottom: 40px;
  }

  .button {
    display: inline-flex;
    gap: 30px;
    align-items: center;
    padding: 17px 28px;
    background: #252521;
    color: white;
    text-decoration: none;
    border-radius: 40px;
    font-size: 13px;
    transition: background 0.2s;
  }

  .button:hover {
    background: #57544e;
  }

  .hero-bottom {
    font-size: 10px;
    letter-spacing: 2px;
    color: #77736b;
  }

  .intro-section {
    padding: 140px 7%;
  }

  .section-heading {
    margin-bottom: 80px;
  }

  .service-list {
    border-top: 1px solid #d3cfc7;
  }

  .service {
    display: grid;
    grid-template-columns: 70px 1fr 30px;
    align-items: center;
    border-bottom: 1px solid #d3cfc7;
    padding: 30px 0;
  }

  .service span {
    font-size: 13px;
    color: #77736b;
  }

  .service h3 {
    font-size: clamp(24px, 3vw, 40px);
    margin: 0;
  }

  .studio {
    display: grid;
    grid-template-columns: 1fr 1fr;
    background: #e8e3d9;
    min-height: 650px;
  }

  .studio-text {
    padding: 120px 14%;
    align-self: center;
  }

  .studio-text p:last-child {
    max-width: 480px;
    font-size: 18px;
    line-height: 1.8;
    color: #69665f;
  }

  .studio-art {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 70px;
    background: #ddd7cb;
  }

  .studio-art img {
    width: min(100%, 360px);
    height: auto;
    object-fit: contain;
  }

  .contact {
    padding: 150px 7%;
    text-align: center;
  }

  .contact h2 {
    margin: 35px auto 50px;
    max-width: 1000px;
  }

  footer {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    padding: 35px 7%;
    border-top: 1px solid #d3cfc7;
    font-size: 12px;
  }

  footer a {
    text-decoration: none;
  }

  @media (max-width: 760px) {
    .header {
      flex-direction: column;
      align-items: flex-start;
      gap: 28px;
      padding: 25px 6%;
    }

    .brand img {
      width: 150px;
    }

    nav {
      flex-wrap: wrap;
      gap: 20px;
    }

    .hero {
      min-height: 75vh;
      padding: 80px 6% 35px;
    }

    .hero-content {
      padding: 0 0 70px;
    }

    .hero-text {
      font-size: 16px;
    }

    .intro-section {
      padding: 90px 6%;
    }

    .section-heading {
      margin-bottom: 50px;
    }

    .service {
      grid-template-columns: 35px 1fr 20px;
      gap: 12px;
      padding: 25px 0;
    }

    .studio {
      grid-template-columns: 1fr;
    }

    .studio-text {
      padding: 90px 6%;
    }

    .studio-art {
      padding: 65px;
      min-height: 350px;
    }

    .contact {
      padding: 100px 6%;
    }

    footer {
      padding: 35px 6%;
      flex-direction: column;
    }
  }
</style>
