---
const base = import.meta.env.BASE_URL;
const logo = `${base}01_hauptlogo_original.png`;
const mark = `${base}05_social_icon_hell.png`;
const email = 'hello@winomedia.ch'; // Vor Veröffentlichung durch echte Adresse ersetzen
---
<!doctype html>
<html lang="de">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#f5f0e8" />
  <meta name="description" content="winomedia – mutige Ideen, Branding, Content und digitales Marketing." />
  <link rel="icon" type="image/png" href={mark} />
  <title>winomedia — Weniger bla. Mehr wow.</title>
</head>
<body>
  <header class="site-header" id="top">
    <a class="logo" href="#top" aria-label="winomedia – zur Startseite"><img src={logo} alt="winomedia Digital Marketing" /></a>
    <nav aria-label="Hauptnavigation"><a href="#leistungen">Leistungen</a><a href="#studio">Studio</a><a class="nav-contact" href="#kontakt">Let's talk <span aria-hidden="true">↗</span></a></nav>
  </header>
  <main>
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-top"><span class="pill">✳ CREATIVE DIGITAL STUDIO</span><span class="micro">IDEAS WITH IMPACT / EST. NOW</span></div>
      <div class="hero-grid">
        <div class="hero-copy"><h1 id="hero-title">WENIGER <em>BLA.</em><br />MEHR <span>WOW.</span></h1><p>Wir machen Marken sichtbar. Mit mutigen Ideen, starkem Design und digitalem Marketing, das etwas bewegt.</p><a class="button dark" href="#kontakt">LET'S MAKE IT HAPPEN <span aria-hidden="true">↗</span></a></div>
        <div class="hero-art" aria-hidden="true"><div class="orbit orbit-one"></div><div class="orbit orbit-two"></div><div class="art-circle"><img src={mark} alt="" /></div><span class="spark">✳</span><span class="art-caption">NO BORING IDEAS<br />ALLOWED.</span></div>
      </div>
      <div class="hero-foot"><span>SCROLL FOR THE GOOD STUFF ↓</span><span>SWISS MADE / CREATIVE MINDED</span></div>
    </section>
    <div class="ticker" aria-label="Bold ideas, real impact"><div class="ticker-track" aria-hidden="true">BOLD IDEAS ✳ REAL IMPACT ✳ NO BORING STUFF ✳ BOLD IDEAS ✳ REAL IMPACT ✳ NO BORING STUFF ✳&nbsp;</div></div>
    <section class="services section" id="leistungen"><div class="section-head"><span class="kicker">01 / WHAT WE DO</span><h2>GOOD IDEAS.<br /><span>BIG IMPACT.</span></h2><p>Von der ersten verrückten Idee bis zum überzeugenden digitalen Auftritt.</p></div><div class="service-list"><div class="service"><span>01</span><h3>Branding & Design</h3><span aria-hidden="true">↗</span></div><div class="service"><span>02</span><h3>Web & Digital</h3><span aria-hidden="true">↗</span></div><div class="service"><span>03</span><h3>Content & Social</h3><span aria-hidden="true">↗</span></div><div class="service"><span>04</span><h3>Strategie & Ideen</h3><span aria-hidden="true">↗</span></div></div></section>
    <section class="studio section" id="studio"><div class="studio-copy"><span class="kicker">02 / THE MINDSET</span><h2>BRAV KANN<br /><em>JEDER.</em></h2><p>Wir mögen klare Gedanken, ungewöhnliche Perspektiven und Gestaltung, die nicht einfach vorbeirauscht. Gute Kommunikation darf Ecken, Kanten und Persönlichkeit haben.</p><a class="text-link" href="#kontakt">LERNE UNS KENNEN ↗</a></div><div class="studio-image"><img src={mark} alt="WM-Grafikelement von winomedia" loading="lazy" /><span>CREATIVITY LOOKS GOOD ON YOU ✳</span></div></section>
    <section class="contact section" id="kontakt"><span class="kicker">03 / SAY HELLO</span><h2>DU HAST 'NE<br /><span>IDEE?</span></h2><p>Wir sind ganz Ohr. Lass uns etwas machen, das hängen bleibt.</p><a class="button light" href={`mailto:${email}?subject=Projektanfrage%20winomedia`}>LET'S TALK <span aria-hidden="true">↗</span></a><small>Kontaktadresse vor Veröffentlichung prüfen.</small></section>
  </main>
  <footer><a href="#top" class="footer-brand">winomedia®</a><span>© {new Date().getFullYear()} WINOMEDIA</span><a href="#top">BACK TO TOP ↑</a></footer>
</body>
</html>
<style>
  @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800;900&display=swap');
  :global(*){box-sizing:border-box} :global(html){scroll-behavior:smooth} :global(body){margin:0;background:#f5f0e8;color:#22211f;font-family:'DM Sans',Arial,sans-serif;-webkit-font-smoothing:antialiased} :global(a){color:inherit} :global(a:focus-visible){outline:3px solid #c58e50;outline-offset:5px} :global(img){max-width:100%}
  .site-header{display:flex;align-items:center;justify-content:space-between;gap:24px;padding:28px 6%;position:relative;z-index:2}.logo img{display:block;width:210px;height:auto}.site-header nav{display:flex;align-items:center;gap:32px}.site-header nav a{text-decoration:none;font-size:13px;font-weight:700}.nav-contact{border:1.5px solid #22211f;padding:12px 20px;border-radius:100px;transition:background .2s,color .2s}.nav-contact:hover{background:#22211f;color:#fff}
  .hero{padding:70px 6% 30px;min-height:calc(100vh - 110px);display:flex;flex-direction:column;justify-content:space-between}.hero-top,.hero-foot{display:flex;justify-content:space-between;gap:16px;align-items:center}.pill{background:#e6b57c;padding:10px 17px;border-radius:100px;font-size:11px;font-weight:900;letter-spacing:.09em}.micro,.hero-foot{font-size:10px;font-weight:800;letter-spacing:.14em}.hero-grid{display:grid;grid-template-columns:1.3fr .7fr;align-items:center;gap:20px;padding:55px 0 65px}.hero h1{font-size:clamp(64px,8.4vw,148px);line-height:.94;letter-spacing:-.085em;margin:0 0 38px;font-weight:900;white-space:nowrap}.hero h1 em{font-style:normal}.hero h1 span{color:#c58e50}.hero-copy p{max-width:540px;font-size:clamp(17px,1.6vw,22px);line-height:1.55;margin:0 0 32px}.button{display:inline-flex;align-items:center;justify-content:space-between;gap:34px;text-decoration:none;padding:19px 26px;border-radius:100px;font-size:12px;font-weight:900;letter-spacing:.04em;transition:transform .2s}.button:hover{transform:translateY(-4px)}.dark{background:#22211f;color:#fff}.light{background:#f5f0e8;color:#22211f}.hero-art{min-height:390px;position:relative;display:grid;place-items:center}.art-circle{width:min(28vw,370px);height:min(28vw,370px);min-width:230px;min-height:230px;border-radius:50%;background:#e5b57f;display:grid;place-items:center;transform:rotate(-12deg);box-shadow:22px 22px 0 #22211f}.art-circle img{width:60%;max-height:65%;object-fit:contain}.orbit{position:absolute;border:1.5px solid #b8aa98;border-radius:50%;width:90%;height:85%;transform:rotate(-28deg)}.orbit-two{transform:rotate(38deg);width:75%;height:100%}.spark{position:absolute;right:4%;top:0;font-size:80px;color:#c58e50;animation:spin 18s linear infinite}.art-caption{position:absolute;bottom:0;left:4%;font-size:12px;font-weight:900;line-height:1.4;transform:rotate(-8deg)}
  .ticker{overflow:hidden;background:#e5b57f;border-top:2px solid #22211f;border-bottom:2px solid #22211f;white-space:nowrap}.ticker-track{display:inline-block;padding:17px 0;font-size:clamp(20px,3vw,38px);font-weight:900;letter-spacing:-.04em;animation:marquee 24s linear infinite}.section{padding:130px 6%}.services{background:#22211f;color:#f5f0e8}.section-head{display:grid;grid-template-columns:1fr 1fr;align-items:end;gap:20px;margin-bottom:65px}.kicker{font-size:12px;font-weight:900;letter-spacing:.14em}.section-head .kicker{grid-column:1/-1;color:#e5b57f}.section h2{font-size:clamp(50px,7vw,110px);line-height:.98;letter-spacing:-.075em;font-weight:900;margin:20px 0}.section-head h2 span{color:#e5b57f}.section-head p{max-width:330px;justify-self:end;line-height:1.7;color:#cbc6bd}.service-list{border-top:1px solid #5e5a55}.service{display:grid;grid-template-columns:60px 1fr 30px;align-items:center;gap:15px;border-bottom:1px solid #5e5a55;padding:26px 0;transition:padding .2s,color .2s}.service:hover{padding-left:15px;color:#e5b57f}.service h3{font-size:clamp(24px,3vw,45px);letter-spacing:-.04em;margin:0}.service>span{font-size:14px}
  .studio{display:grid;grid-template-columns:1fr 1fr;gap:70px;align-items:center}.studio h2 em{color:#c58e50;font-style:normal}.studio-copy p{font-size:19px;line-height:1.75;max-width:520px}.text-link{display:inline-block;margin-top:22px;font-size:13px;font-weight:900;text-decoration:none;border-bottom:2px solid;padding-bottom:8px}.studio-image{min-height:470px;background:#e8d4bb;border-radius:50% 50% 8px 8px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:30px;padding:40px;transform:rotate(3deg)}.studio-image img{width:min(70%,330px);object-fit:contain}.studio-image span{font-size:12px;font-weight:900;letter-spacing:.1em;text-align:center}
  .contact{background:#c58e50;text-align:center}.contact h2{font-size:clamp(70px,11vw,165px);margin:30px 0}.contact h2 span{-webkit-text-stroke:2px #22211f;color:transparent}.contact p{font-size:20px;line-height:1.5}.contact .button{margin:24px 0}.contact small{display:block;font-size:11px;opacity:.8}footer{padding:32px 6%;display:flex;align-items:center;justify-content:space-between;gap:20px;font-size:12px;font-weight:800}footer a{text-decoration:none}.footer-brand{font-size:22px;letter-spacing:-.05em}
  @keyframes marquee{to{transform:translateX(-50%)}}@keyframes spin{to{transform:rotate(360deg)}}
  @media(max-width:950px){.hero-grid{grid-template-columns:1fr}.hero h1{font-size:clamp(60px,12vw,110px)}.hero-art{min-height:330px}.art-circle{width:280px;height:280px}.studio{grid-template-columns:1fr}.section-head{grid-template-columns:1fr}.section-head p{justify-self:start}.studio-image{min-height:360px}}
  @media(max-width:600px){.site-header{padding:22px 5%;align-items:flex-start;flex-direction:column}.logo img{width:170px}.site-header nav{gap:18px;flex-wrap:wrap}.site-header nav a{font-size:12px}.nav-contact{padding:9px 14px}.hero{padding:48px 5% 25px}.hero-top{align-items:flex-start;flex-direction:column}.hero-grid{padding:65px 0 35px}.hero h1{font-size:clamp(45px,11.5vw,70px);white-space:normal}.hero-copy p{font-size:17px}.hero-art{min-height:290px}.art-circle{min-width:200px;min-height:200px;width:220px;height:220px}.spark{font-size:55px}.hero-foot{font-size:9px}.hero-foot span:last-child{display:none}.section{padding:85px 5%}.service{grid-template-columns:35px 1fr 20px}.studio{gap:45px}.studio-image{min-height:310px}.contact h2{font-size:clamp(56px,12vw,85px)}footer{flex-wrap:wrap;padding:28px 5%}}
  @media(prefers-reduced-motion:reduce){:global(html){scroll-behavior:auto}.ticker-track,.spark{animation:none}.button,.service{transition:none}}
</style>
