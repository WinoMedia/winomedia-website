---
const title = "winomedia – Creative Digital Studio";
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="winomedia – Kreative Kommunikation, Design und digitale Medien." />
    <title>{title}</title>
  </head>

  <body>
    <header>
      <a class="logo" href="#start">winomedia<span>®</span></a>
      <nav aria-label="Hauptnavigation">
        <a href="#leistungen">Leistungen</a>
        <a href="#studio">Studio</a>
        <a href="#kontakt">Kontakt</a>
      </nav>
    </header>

    <main id="start">
      <section class="hero">
        <p class="eyebrow">CREATIVE DIGITAL STUDIO</p>
        <h1>Ideen sichtbar machen.<br />Marken bewegen.</h1>
        <p class="intro">
          Wir gestalten digitale Erlebnisse und kreative
          Kommunikation mit Klarheit, Charakter und Wirkung.
        </p>
        <a class="button" href="#kontakt">Projekt anfragen ↗</a>
      </section>

      <section class="section" id="leistungen">
        <p class="eyebrow">01 / LEISTUNGEN</p>
        <h2>Weniger Ablenkung.<br />Mehr Wirkung.</h2>
        <div class="services">
          <div>Strategie & Konzeption <span>↗</span></div>
          <div>Branding & Design <span>↗</span></div>
          <div>Web & Digital <span>↗</span></div>
          <div>Content & Kommunikation <span>↗</span></div>
        </div>
      </section>

      <section class="section about" id="studio">
        <p class="eyebrow">02 / STUDIO</p>
        <h2>Gute Ideen verdienen gutes Design.</h2>
        <p>
          winomedia verbindet kreative Ideen mit durchdachter
          Gestaltung und zeitgemässer digitaler Kommunikation.
        </p>
      </section>

      <section class="section contact" id="kontakt">
        <p class="eyebrow">03 / KONTAKT</p>
        <h2>Gemeinsam etwas bewegen.</h2>
        <a class="button" href="mailto:hello@winomedia.ch">
          Kontakt aufnehmen ↗
        </a>
      </section>
    </main>

    <footer>
      <span>© {new Date().getFullYear()} winomedia</span>
      <span>Creative Digital Studio</span>
    </footer>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    scroll-behavior: smooth;
  }

  :global(body) {
    margin: 0;
    background: #f7f5f0;
    color: #252521;
    font-family: Arial, Helvetica, sans-serif;
    -webkit-font-smoothing: antialiased;
  }

  header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 32px 7%;
  }

  .logo {
    font-size: 26px;
    font-weight: 700;
    letter-spacing: -1.5px;
    text-decoration: none;
    color: inherit;
  }

  .logo span {
    font-size: 10px;
    vertical-align: top;
    margin-left: 3px;
  }

  nav {
    display: flex;
    gap: 30px;
  }

  nav a {
    color: inherit;
    text-decoration: none;
    font-size: 13px;
  }

  .hero {
    min-height: 78vh;
    padding: 130px 7% 120px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
  }

  .eyebrow {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 2px;
    text-transform: uppercase;
    margin-bottom: 30px;
  }

  h1, h2 {
    font-weight: 400;
    letter-spacing: -0.055em;
    line-height: 1.08;
  }

  h1 {
    font-size: clamp(48px, 7.5vw, 112px);
    margin: 0 0 35px;
  }

  h2 {
    font-size: clamp(40px, 5vw, 76px);
    margin: 0 0 40px;
  }

  .intro {
    max-width: 520px;
    font-size: 19px;
    line-height: 1.7;
    color: #66645f;
    margin-bottom: 35px;
  }

  .button {
    display: inline-block;
    padding: 16px 26px;
    border-radius: 40px;
    background: #252521;
    color: white;
    text-decoration: none;
    font-size: 13px;
    transition: background 0.2s;
  }

  .button:hover {
    background: #55534e;
  }

  .section {
    padding: 120px 7%;
  }

  .services {
    margin-top: 65px;
    border-top: 1px solid #ccc8c0;
  }

  .services div {
    display: flex;
    justify-content: space-between;
    padding: 28px 0;
    border-bottom: 1px solid #ccc8c0;
    font-size: clamp(20px, 3vw, 32px);
  }

  .about {
    background: #e9e5dc;
  }

  .about p:last-child {
    max-width: 600px;
    font-size: 19px;
    line-height: 1.7;
    color: #66645f;
  }

  .contact {
    text-align: center;
  }

  .contact h2 {
    max-width: 850px;
    margin: 0 auto 40px;
  }

  footer {
    display: flex;
    justify-content: space-between;
    padding: 35px 7%;
    border-top: 1px solid #dedbd4;
    font-size: 12px;
  }

  @media (max-width: 700px) {
    header {
      padding: 25px 6%;
      align-items: flex-start;
      gap: 20px;
      flex-direction: column;
    }

    nav {
      flex-wrap: wrap;
      gap: 18px;
    }

    .hero {
      min-height: 65vh;
      padding: 90px 6%;
    }

    .section {
      padding: 80px 6%;
    }

    .intro {
      font-size: 16px;
    }

    footer {
      flex-direction: column;
      gap: 12px;
    }
  }
</style>
